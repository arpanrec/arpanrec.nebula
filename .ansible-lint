---
exclude_paths:
    - .ansible
    - .gitea
    - .github
    - .venv
    - docs
    - .idea
    - .vscode
    - README.md
    - .claude
    - .agents
    - DEVELOPMENT.md
    - ansible.cfg
    - .prettierignore
    - LICENSE
    - .gitignore
    - .git-hooks
    - uv.lock
    - pyproject.toml
    - .gitattributes
    - .prettierrc.mjs
    - CLAUDE.md
    - AGENTS.md
profile: production
skip_list: []
verbosity: 2
